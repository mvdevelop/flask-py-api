# ==============================
# PyStore API — Environment Variables
# ==============================
# Copie este arquivo para .env e preencha com valores seguros.
# Gere chaves seguras com: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- Flask ---
FLASK_ENV=production
SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- JWT ---
# Necessário em produção — fail-fast se não definido
JWT_SECRET_KEY=generate-with: python -c "import secrets; print(secrets.token_urlsafe(32))"

# --- MongoDB ---
# Exemplo Atlas: mongodb+srv://user:pass@cluster.mongodb.net/pystore
MONGO_URI=mongodb://localhost:27017/py_store
MONGO_DB=py_store

# --- CORS ---
# Origens permitidas (comma-separated)
# Ex: https://meusite.com.br,https://admin.meusite.com.br
CORS_ORIGINS=

# --- Uploads ---
UPLOAD_BASE_URL=http://localhost:5000

# --- Server ---
PORT=5000
